# 密钥只放在后端；实际 .env 不进入压缩包或版本库。
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
AMAP_WEB_SERVICE_KEY=
# GCJ-02 经度,纬度。请设置真实校园中心，默认不指定位置。
CAMPUS_LOCATION='113.298214,23.096746'
FUNASR_WS_URL=
# 仅在 HTTPS 部署时设为 true
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# 高德 JS API 的安全密钥，仅由后端代理追加
AMAP_SECURITY_CODE=

CAMPUS_ADDRESS=广州市海珠区新港西路135号中山大学南校园
